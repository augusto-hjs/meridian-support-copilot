# ---- Meridian Support Copilot ----
# Copy to .env and fill in. NEVER commit .env with real values.

# --- OpenAI (chat + embeddings) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx        # server-side only, bypasses RLS
SUPABASE_DB_URL=postgresql://...          # optional, for running migrations directly

# --- n8n ---
N8N_WEBHOOK_URL=https://<your-n8n>/webhook/meridian-support
